# Copie para docker/.env e preencha os valores reais. NUNCA versionar .env.

# RabbitMQ (usuarios de desenvolvimento; producao exige usuarios proprios
# por servico, criados manualmente com rabbitmqctl - veja README)
RABBITMQ_DEFAULT_USER=alterar_usuario
RABBITMQ_DEFAULT_PASS=alterar_senha_forte

# Credenciais usadas pelo servico Java para consumir a fila
RABBITMQ_USERNAME=alterar_usuario
RABBITMQ_PASSWORD=alterar_senha_forte

# WAHA (WhatsApp HTTP API)
WAHA_API_KEY=alterar_chave_waha
WAHA_API_URL=http://localhost:3000
WAHA_SESSION=Teste

# Twilio (opcional; usado quando whatsapp.provider=twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY_SID=
TWILIO_WHATSAPP_NUMBER=
